# Copy to .env and edit. All values have safe defaults except the two secrets below.

# HTTP port the server listens on.
PORT=8080

# Bearer token the TVs use to pull credentials (GET /api/credentials).
# Generate a long random string, e.g.:  openssl rand -hex 24
JTV_SERVER_TOKEN=change-me-to-a-long-random-string

# Password for the admin web dashboard (login / OTP setup / status).
ADMIN_PASSWORD=change-me

# Where SQLite + state is stored (mounted as a Docker volume in compose).
DATA_DIR=./data
